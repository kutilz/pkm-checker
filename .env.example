# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya.
# Jangan pernah commit file .env ke repository!

# Google Gemini API Key (opsional)
# Diperoleh dari: https://aistudio.google.com/app/apikey
# Jika tidak diisi, fitur analisis sitasi Gemini akan dinonaktifkan.
GEMINI_API_KEY=

# Model Gemini (opsional, default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
